
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects.js";
---

<BaseLayout
  title="Research Projects — Abitatha Roy"
  description="Selected research projects, quantitative analyses, and computational work by Abitatha Roy."
>
  <section class="projects-page page-container">
    <p class="eyebrow">RESEARCH & COMPUTATION</p>

    <h1>Research projects<span class="accent">.</span></h1>

    <p class="page-intro">
      A collection of research questions, analytical investigations, and
      computational projects. Each explores a problem through appropriate
      methods, evidence, and critical thinking.
    </p>

    <div class="project-list">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="project-number">{project.number}</div>

            <div class="project-content">
              <p class="project-category">{project.category}</p>
              <h3>{project.title}</h3>
              <p class="project-description">{project.description}</p>
              <span class="project-status">{project.status}</span>
            </div>

            {
              project.hasDetailPage ? (
                <a
                  class="project-link"
                  href={`/projects/${project.slug}/`}
                  aria-label={`Explore ${project.title}`}
                >
                  ↗
                </a>
              ) : (
                <span class="project-link" aria-hidden="true">
                  ↗
                </span>
              )
            }
          </article>
        ))
      }
    </div>

    <a class="back-link" href="/">← Back to homepage</a>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding-top: 100px;
    padding-bottom: 100px;
  }

  .projects-page h1 {
    margin-bottom: 24px;
  }

  .page-intro {
    max-width: 650px;
    margin-bottom: 64px;
    color: var(--color-muted);
    font-size: 18px;
    line-height: 1.8;
  }

  .project-list .project-card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .project-card h3 {
    margin-bottom: 12px;
  }

  .back-link {
    display: inline-block;
    margin-top: 44px;
    color: var(--color-muted);
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 700px) {
    .projects-page {
      padding-top: 64px;
      padding-bottom: 64px;
    }

    .page-intro {
      margin-bottom: 40px;
      font-size: 16px;
    }
  }
</style>
