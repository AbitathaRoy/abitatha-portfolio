
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects.js";

const researchInterests = [
  "Quantitative research",
  "Statistics & mathematical modelling",
  "Data science & machine learning",
  "Research design & measurement",
];
---

<BaseLayout
  title="Abitatha Roy — Research & Computing"
  description="Academic and technical portfolio exploring quantitative research, statistics, data science, and computational methods."
>
  <section class="hero" id="about">
    <p class="eyebrow">
      INDEPENDENT THINKING · QUANTITATIVE INQUIRY
    </p>

    <h1>
      Making sense<br />
      of the world<span class="accent">.</span>
    </h1>

    <p class="hero-description">
      I'm Abitatha Roy, an undergraduate student of Information
      Technology and Mathematical Innovations at the Cluster
      Innovation Centre, University of Delhi.
    </p>

    <p class="hero-description secondary">
      I'm interested in how we frame meaningful research questions,
      design sound investigations, and use statistics, data science,
      and computation to understand patterns and relationships
      underlying real-world phenomena.
    </p>

    <div class="hero-links">
      <a class="primary-link" href="#projects">
        Explore selected work <span aria-hidden="true">↓</span>
      </a>
      <a class="text-link" href="#research">Research interests</a>
    </div>

    <div class="hero-meta">
      <span>BASED IN INDIA</span>
      <span>B.TECH. · CLASS OF 2027</span>
    </div>
  </section>

  <section class="research-section section-rule" id="research">
    <div class="section-heading">
      <p class="eyebrow">01 / AREAS OF INTEREST</p>
      <h2>Questions first.<br />Methods follow.</h2>
    </div>

    <div class="interest-list">
      {
        researchInterests.map((interest, index) => (
          <div class="interest-item">
            <span class="item-number">
              0{index + 1}
            </span>
            <span>{interest}</span>
            <span class="item-arrow" aria-hidden="true">↗</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="projects-section section-rule" id="projects">
    <div class="projects-heading">
      <div>
        <p class="eyebrow">02 / SELECTED WORK</p>
        <h2>Research Projects</h2>
      </div>

      <div class="projects-heading-action">
        <p class="section-note">
          A growing collection of research, analysis, and technical work.
        </p>
        <a class="text-link" href="/projects/">View all projects ↗</a>
      </div>
    </div>

    <div class="project-list">
      {
        projects.filter((project) => project.featured).map((project) => (
          <article class="project-card">
            <div class="project-number">{project.number}</div>

            <div class="project-content">
              <p class="project-category">{project.category}</p>
              <h3>{project.title}</h3>
              <p class="project-description">
                {project.description}
              </p>
              <span class="project-status">{project.status}</span>
            </div>

            {
              project.hasDetailPage ? (
                <a
                  class="project-link"
                  href={`/projects/${project.slug}/`}
                  aria-label={`Explore ${project.title}`}
                >
                  ↗
                </a>
              ) : (
                <span class="project-link" aria-hidden="true">
                  ↗
                </span>
              )
            }
          </article>
        ))
      }
    </div>
  </section>

  <section class="closing-section section-rule" id="contact">
    <p class="eyebrow">03 / CONTINUING THE INQUIRY</p>

    <h2>
      Curiosity is a starting point.<br />
      <span>Rigour makes it research.</span>
    </h2>

    <p>
      I hope to keep developing the mathematical, statistical, and
      computational tools needed to investigate meaningful questions.
    </p>

    <a class="primary-link" href="mailto:YOUR_EMAIL@example.com">
      Start a conversation <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>

<style>
  /* Homepage-specific styles only */

  .hero,
  .research-section,
  .projects-section,
  .closing-section {
    padding-left: 14%;
    padding-right: 14%;
  }

  .hero {
    padding-top: 116px;
    padding-bottom: 76px;
    max-width: 1440px;
  }

  .hero-description {
    max-width: 590px;
    font-size: 18px;
    line-height: 1.8;
    color: #41423d;
  }

  .secondary {
    max-width: 620px;
    margin-top: 12px;
    color: var(--color-muted);
    font-size: 16px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 34px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 86px;
    color: #88877f;
    font-size: 13px;
    letter-spacing: 1.3px;
  }

  .research-section {
    padding-top: 64px;
    padding-bottom: 78px;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
  }

  .interest-list {
    padding-top: 17px;
  }

  .interest-item {
    min-height: 60px;
    display: grid;
    grid-template-columns: 35px minmax(0, 1fr) 20px;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    font-size: 16px;
  }

  .item-number,
  .item-arrow {
    color: #929087;
    font-size: 15px;
  }

  .projects-section {
    padding-top: 65px;
    padding-bottom: 80px;
  }

  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
  }

  .section-note {
    max-width: 250px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 0;
  }

  .project-list .project-card:first-child {
    border-top: 1px solid var(--color-border);
  }

  .closing-section {
    padding-top: 72px;
    padding-bottom: 80px;
    background: var(--color-surface);
  }

  .closing-section h2 span {
    color: var(--color-accent);
  }

  .closing-section > p:not(.eyebrow) {
    max-width: 510px;
    margin-bottom: 28px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.9;
  }

  .projects-heading-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  @media (max-width: 700px) {
    .hero,
    .research-section,
    .projects-section,
    .closing-section {
      padding-left: 7%;
      padding-right: 7%;
    }

    .hero {
      padding-top: 84px;
      padding-bottom: 58px;
    }

    .hero-description {
      font-size: 15px;
    }

    .hero-meta {
      margin-top: 60px;
      gap: 13px;
    }

    .research-section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-top: 45px;
      padding-bottom: 55px;
    }

    .projects-heading {
      align-items: start;
      flex-direction: column;
      gap: 0;
    }

    .section-note {
      margin-top: 0;
    }

    .projects-heading-action {
      margin-top: 12px;
    }
  }
</style>