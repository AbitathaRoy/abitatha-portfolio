
---
const researchInterests = [
  "Quantitative research",
  "Statistics & mathematical modelling",
  "Data science & machine learning",
  "Research design & measurement",
];

const projects = [
  {
    number: "01",
    category: "BIOMEDICAL RESEARCH · META-ANALYSIS",
    title: "Evaluating AI-assisted diagnostic performance",
    description:
      "A systematic review and meta-analysis examining diagnostic accuracy in biomedical imaging.",
    status: "Research project",
    href: "#",
  },
  {
    number: "02",
    category: "APPLIED STATISTICS · RESEARCH INTERNSHIP",
    title: "Enterprise digital transformation",
    description:
      "Quantitative analysis of enterprise characteristics and technology adoption using survey data.",
    status: "Research experience",
    href: "#",
  },
  {
    number: "03",
    category: "COMPUTING · SOFTWARE PROJECT",
    title: "Algorithms and computational systems",
    description:
      "Selected programming work exploring algorithmic logic, implementation, and computational problem-solving.",
    status: "Technical project",
    href: "#",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f8f7f4" />
    <meta
      name="description"
      content="The academic and technical portfolio of Abitatha Roy, exploring quantitative research, statistics, data science, and computational methods."
    />
    <title>Abitatha Roy — Research & Computing</title>
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Abitatha Roy, home">
        AR<span>.</span>
      </a>

      <nav aria-label="Main navigation">
        <a href="#research">Research</a>
        <a href="#projects">Projects</a>
        <a href="#about">About</a>
        <a class="nav-contact" href="mailto:YOUR_EMAIL@example.com">
          Get in touch <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero" id="about">
        <p class="eyebrow">
          INDEPENDENT THINKING · QUANTITATIVE INQUIRY
        </p>

        <h1>
          Making sense<br />
          of the world<span class="accent">.</span>
        </h1>

        <p class="hero-description">
          I'm Abitatha Roy, an undergraduate student of Information
          Technology and Mathematical Innovations at the Cluster
          Innovation Centre, University of Delhi.
        </p>

        <p class="hero-description secondary">
          I'm interested in how we frame meaningful research questions,
          design sound investigations, and use statistics, data science,
          and computation to understand the patterns and relationships
          underlying real-world phenomena.
        </p>

        <div class="hero-links">
          <a class="primary-link" href="#projects">
            Explore selected work <span aria-hidden="true">↓</span>
          </a>
          <a class="text-link" href="#research">Research interests</a>
        </div>

        <div class="hero-meta">
          <span>BASED IN INDIA</span>
          <span>B.TECH. · CLASS OF 2027</span>
        </div>
      </section>

      <section class="research-section section-rule" id="research">
        <div class="section-heading">
          <p class="eyebrow">01 / AREAS OF INTEREST</p>
          <h2>Questions first.<br />Methods follow.</h2>
        </div>

        <div class="interest-list">
          {
            researchInterests.map((interest, index) => (
              <div class="interest-item">
                <span class="item-number">
                  0{index + 1}
                </span>
                <span>{interest}</span>
                <span class="item-arrow" aria-hidden="true">↗</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="projects-section section-rule" id="projects">
        <div class="projects-heading">
          <div>
            <p class="eyebrow">02 / SELECTED WORK</p>
            <h2>Research & projects</h2>
          </div>
          <p class="section-note">
            A growing collection of research, analysis, and technical work.
          </p>
        </div>

        <div class="project-list">
          {
            projects.map((project) => (
              <article class="project-card">
                <div class="project-number">{project.number}</div>
                <div class="project-content">
                  <p class="project-category">{project.category}</p>
                  <h3>{project.title}</h3>
                  <p class="project-description">{project.description}</p>
                  <span class="project-status">{project.status}</span>
                </div>
                <a
                  class="project-link"
                  href={project.href}
                  aria-label={`Explore ${project.title}`}
                >
                  ↗
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="closing-section section-rule">
        <p class="eyebrow">03 / CONTINUING THE INQUIRY</p>
        <h2>Curiosity is a starting point.<br />
          <span>Rigour makes it research.</span>
        </h2>
        <p>
          I hope to keep developing the mathematical, statistical, and
          computational tools needed to investigate meaningful questions.
        </p>
        <a class="primary-link" href="mailto:YOUR_EMAIL@example.com">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <a class="wordmark" href="/">AR<span>.</span></a>
      <span>Designed & developed by Abitatha Roy.</span>
      <a href="#top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
        Back to top ↑
      </a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: #f8f7f4;
    color: #252722;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    min-height: 78px;
    padding: 0 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #e5e3dc;
  }

  .wordmark {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -1.5px;
  }

  .wordmark span,
  .accent {
    color: #8b593f;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 12px;
  }

  nav a:not(.nav-contact) {
    color: #62635c;
  }

  .nav-contact {
    border: 1px solid #d9d7cf;
    border-radius: 3px;
    padding: 11px 14px;
  }

  .hero,
  .research-section,
  .projects-section,
  .closing-section {
    padding-left: 14%;
    padding-right: 14%;
  }

  .hero {
    padding-top: 116px;
    padding-bottom: 76px;
    max-width: 1440px;
  }

  .eyebrow {
    color: #8b593f;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
    line-height: 1.8;
  }

  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 {
    margin: 27px 0 28px;
    font-size: clamp(54px, 7.5vw, 100px);
    line-height: 0.99;
    letter-spacing: -5px;
  }

  .hero-description {
    max-width: 590px;
    font-size: 17px;
    line-height: 1.8;
    color: #41423d;
  }

  .secondary {
    max-width: 620px;
    margin-top: 14px;
    color: #74756e;
    font-size: 15px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 34px;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 14px 17px;
    background: #292b26;
    color: white;
    border-radius: 3px;
    font-size: 12px;
  }

  .text-link {
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 86px;
    color: #88877f;
    font-size: 9px;
    letter-spacing: 1.3px;
  }

  .section-rule {
    border-top: 1px solid #e5e3dc;
  }

  .research-section {
    padding-top: 64px;
    padding-bottom: 78px;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 60px;
  }

  h2 {
    margin: 18px 0;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.15;
    letter-spacing: -1.5px;
  }

  .interest-list {
    padding-top: 17px;
  }

  .interest-item {
    min-height: 60px;
    display: grid;
    grid-template-columns: 35px 1fr 20px;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid #e5e3dc;
    font-size: 13px;
  }

  .item-number,
  .item-arrow {
    color: #929087;
    font-size: 11px;
  }

  .projects-section {
    padding-top: 65px;
    padding-bottom: 80px;
  }

  .projects-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
  }

  .section-note {
    max-width: 250px;
    color: #77776f;
    font-size: 12px;
    line-height: 1.8;
  }

  .project-card {
    display: grid;
    grid-template-columns: 48px 1fr 24px;
    gap: 20px;
    padding: 29px 0;
    border-top: 1px solid #e5e3dc;
  }

  .project-number {
    padding-top: 2px;
    color: #8b593f;
    font-size: 11px;
  }

  .project-category {
    margin: 0 0 12px;
    color: #8b593f;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    line-height: 1.7;
  }

  h3 {
    margin: 0 0 10px;
    font-size: clamp(22px, 3vw, 29px);
    letter-spacing: -0.5px;
  }

  .project-description {
    max-width: 560px;
    color: #696a62;
    font-size: 13px;
    line-height: 1.8;
  }

  .project-status {
    display: inline-block;
    margin-top: 7px;
    padding: 6px 8px;
    border: 1px solid #e1dfd7;
    color: #696a62;
    font-size: 10px;
  }

  .project-link {
    font-size: 18px;
  }

  .closing-section {
    padding-top: 72px;
    padding-bottom: 80px;
    background: #f0eee7;
  }

  .closing-section h2 span {
    color: #8b593f;
  }

  .closing-section > p:not(.eyebrow) {
    max-width: 510px;
    margin-bottom: 28px;
    color: #686960;
    font-size: 14px;
    line-height: 1.9;
  }

  .site-footer {
    min-height: 90px;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    color: #73736b;
    font-size: 10px;
  }

  @media (max-width: 700px) {
    .site-header {
      min-height: 70px;
      padding: 0 6%;
    }

    nav {
      gap: 14px;
      font-size: 11px;
    }

    nav a:nth-child(2),
    nav a:nth-child(3) {
      display: none;
    }

    .hero,
    .research-section,
    .projects-section,
    .closing-section {
      padding-left: 7%;
      padding-right: 7%;
    }

    .hero {
      padding-top: 84px;
      padding-bottom: 58px;
    }

    h1 {
      font-size: clamp(53px, 12vw, 76px);
      letter-spacing: -3px;
    }

    .hero-description {
      font-size: 15px;
    }

    .hero-meta {
      margin-top: 60px;
      gap: 13px;
    }

    .research-section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding-top: 45px;
      padding-bottom: 55px;
    }

    .projects-heading {
      align-items: start;
      flex-direction: column;
      gap: 0;
    }

    .section-note {
      margin-top: 0;
    }

    .project-card {
      grid-template-columns: 25px 1fr 16px;
      gap: 10px;
      padding: 24px 0;
    }

    .project-category {
      font-size: 8px;
    }

    .site-footer {
      padding: 24px 7%;
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>
